{SECT 0 {EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 5182 "# Appendix B.1: co
verage and rigorous derivative enclosures.\n# All arithmetic is exact \+
rational arithmetic.\n# The output is used by the lower-bound calculat
ion in B.2--B.3.\n\nB1_GRID  := 10^30:\nB1_ALPHA := [41/25, 33/20]:\nB
1_BETA  := 13/10000:\n\n# Outward rounding to multiples of 10^(-30).\n
B1_Down := proc(x::rational)\n    return floor(B1_GRID*x)/B1_GRID;\nen
d proc:\n\nB1_Up := proc(x::rational)\n    return -floor(-B1_GRID*x)/B
1_GRID;\nend proc:\n\n# An interval is represented by [lower endpoint,
 upper endpoint].\nB1_Add := proc(A::list, B::list)\n    return [\n   \+
     B1_Down(A[1] + B[1]),\n        B1_Up(A[2] + B[2])\n    ];\nend pr
oc:\n\nB1_Mul := proc(A::list, B::list)\n    local products;\n\n    pr
oducts := [\n        A[1]*B[1], A[1]*B[2],\n        A[2]*B[1], A[2]*B[
2]\n    ];\n\n    return [\n        B1_Down(min(op(products))),\n     \+
   B1_Up(max(op(products)))\n    ];\nend proc:\n\n# Rigorous bounds fo
r exp(x), using the degree-24 Taylor sum\n# and the geometric upper bo
und for its remainder.\nB1_ExpAt := proc(x::rational)\n    local term,
 total, r, nextTerm, tailUpper;\n\n    if x < 0 or x > 13/5 then\n    \+
    error \"exponential argument outside [0,13/5]: %1\", x;\n    end i
f;\n\n    if x/26 >= 1 then\n        error \"invalid geometric-tail ra
tio: %1\", x/26;\n    end if;\n\n    term  := 1;\n    total := 1;\n\n \+
   for r from 1 to 24 do\n        term  := term*x/r;\n        total :=
 total + term;\n    end do;\n\n    nextTerm := term*x/25;\n    tailUpp
er := nextTerm/(1 - x/26);\n\n    return [\n        B1_Down(total),\n \+
       B1_Up(total + tailUpper)\n    ];\nend proc:\n\n# Polynomial coe
fficients in ascending powers of z.\n# P[j](z) represents v^(j)(w) whe
n z = tanh(w/2).\n# Recurrence: P[j+1] = (1-z^2)*P[j]'/2.\nB1_Polynomi
als := proc()\n    local z, p, polynomials, j, k;\n\n    polynomials :
= Array(0..5, datatype=anything);\n    p := (1 - z^2)/4;\n\n    for j \+
from 0 to 5 do\n        polynomials[j] := [\n            seq(coeff(p, \+
z, k), k = 0..degree(p, z))\n        ];\n\n        if j < 5 then\n    \+
        p := expand((1 - z^2)*diff(p, z)/2);\n        end if;\n    end
 do;\n\n    return polynomials;\nend proc:\n\n# Horner evaluation with
 outward-rounded interval operations.\nB1_Horner := proc(coefficients:
:list, X::list)\n    local answer, k;\n\n    answer := [0, 0];\n\n    \+
for k from nops(coefficients) by -1 to 1 do\n        answer := B1_Add(
\n            B1_Mul(answer, X),\n            [coefficients[k], coeffi
cients[k]]\n        );\n    end do;\n\n    return answer;\nend proc:\n
\nB1_Verify := proc()\n    local data, polynomials, cellIndex, W,\n   \+
       Eleft, Eright, Tint, V, j, previous,\n          cellCount, expC
ount, derivativeCount;\n\n    data := Array(0..2599, datatype=anything
);\n    polynomials := B1_Polynomials();\n\n    previous := 0;\n    ce
llCount := 0;\n    expCount := 0;\n    derivativeCount := 0;\n\n    fo
r cellIndex from 0 to 2599 do\n\n        W := [cellIndex/1000, (cellIn
dex + 1)/1000];\n\n        # Check adjacency and the exact width of ev
ery cell.\n        if W[1] <> previous\n           or W[2] - W[1] <> 1
/1000 then\n            error \"coverage failure at cell %1\", cellInd
ex;\n        end if;\n\n        Eleft  := B1_ExpAt(W[1]);\n        Eri
ght := B1_ExpAt(W[2]);\n\n        if Eleft[1] < 1 or Eleft[1] > Eleft[
2]\n           or Eright[1] < 1 or Eright[1] > Eright[2] then\n       \+
     error \"invalid exponential enclosure at cell %1\",\n            \+
      cellIndex;\n        end if;\n\n        expCount := expCount + 2;
\n\n        # exp(w) and (x-1)/(x+1) are increasing.\n        # Hence \+
this interval encloses tanh(w/2) on all of W.\n        Tint := [\n    \+
        B1_Down((Eleft[1] - 1)/(Eleft[1] + 1)),\n            B1_Up((Er
ight[2] - 1)/(Eright[2] + 1))\n        ];\n\n        if Tint[1] < 0 or
 Tint[1] > Tint[2]\n           or Tint[2] >= 1 then\n            error
 \"invalid tanh enclosure at cell %1\", cellIndex;\n        end if;\n
\n        # V[j+1] encloses v^(j)(w), j = 0,...,5,\n        # througho
ut the entire closed interval W.\n        V := [\n            seq(B1_H
orner(polynomials[j], Tint), j = 0..5)\n        ];\n\n        for j fr
om 1 to 6 do\n            if not type(V[j][1], rational)\n            \+
   or not type(V[j][2], rational)\n               or V[j][1] > V[j][2]
 then\n                error \"invalid derivative enclosure: cell %1, \+
order %2\",\n                      cellIndex, j - 1;\n            end \+
if;\n\n            derivativeCount := derivativeCount + 1;\n        en
d do;\n\n        # The positive lower endpoint is needed in B.2.\n    \+
    if V[1][1] <= 0 then\n            error \"nonpositive lower bound \+
for v at cell %1\",\n                  cellIndex;\n        end if;\n\n
        # Store [w interval, tanh interval, derivative intervals].\n  \+
      data[cellIndex] := [W, Tint, V];\n\n        previous := W[2];\n \+
       cellCount := cellCount + 1;\n    end do;\n\n    if previous <> \+
13/5 or cellCount <> 2600\n       or expCount <> 5200 or derivativeCou
nt <> 15600 then\n        error \"incorrect domain coverage or verific
ation count\";\n    end if;\n\n    print([\"B1_COVERAGE_PASS\", cellCo
unt]);\n    print([\"B1_EXPONENTIAL_ENCLOSURES_PASS\", expCount]);\n  \+
  print([\"B1_DERIVATIVE_ENCLOSURES_PASS\", derivativeCount]);\n    pr
int(\"APPENDIX_B1_PASS\");\n\n    return data;\nend proc:\n\n# Run the
 certificate and retain its interval data.\nB1Data := B1_Verify():" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#7$Q1B1_COVERAGE_PASS6\"\"%+E" }}{PARA 
11 "" 1 "" {XPPMATH 20 "6#7$Q?B1_EXPONENTIAL_ENCLOSURES_PASS6\"\"%+_" 
}}{PARA 11 "" 1 "" {XPPMATH 20 "6#7$Q>B1_DERIVATIVE_ENCLOSURES_PASS6\"
\"&+c\"" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#Q1APPENDIX_B1_PASS6\"" }}}
